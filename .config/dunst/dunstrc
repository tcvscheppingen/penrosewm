# Restart dunst after changing this file: killall dunst; dunst &

[global]
    font = JetBrainsMono Nerd Font 10
    origin = top-right
    offset = (10, 10)
    width = 350
    gap_size = 10
    padding = 10
    horizontal_padding = 10
    frame_width = 3
    corner_radius = 0
    separator_height = 0
    progress_bar_frame_width = 0
    highlight = "#5e81ac"
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#2e3440"
    foreground = "#a0a8b7"
    frame_color = "#4c566a"
    timeout = 5

[urgency_normal]
    background = "#2e3440"
    foreground = "#d8dee9"
    frame_color = "#5e81ac"
    timeout = 5

[urgency_critical]
    background = "#2e3440"
    foreground = "#d8dee9"
    frame_color = "#bf616a"
    timeout = 0
